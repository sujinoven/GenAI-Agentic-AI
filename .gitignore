# =========================================================
# Machine Learning datasets
# =========================================================
# Ignore datasets by default
data/*

# But allow the data folder itself
!data/

# If you specifically want to keep a tiny sample dataset:
# !data/sample.csv

# Common dataset formats
*.tsv
*.json
*.jsonl
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.db
*.sqlite
*.sqlite3
*.zip

